# Local dev falls back to SQLite if DATABASE_URL is unset.
# Railway injects DATABASE_URL automatically when you attach a Postgres service.
DATABASE_URL=

# Comma-separated allowed origins for the frontend.
# Include your Vercel prod domain. Preview URLs are matched by regex automatically.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Medical ID translation (POST /translate). The public instance needs an API key
# from https://portal.libretranslate.com; point the URL at a self-hosted
# LibreTranslate to go without one.
LIBRETRANSLATE_URL=https://libretranslate.com
LIBRETRANSLATE_API_KEY=
